rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Academy ERP state for real-time synchronization across director, staff, tablet kiosk, and Netlify app
    match /academy/{docId} {
      allow read, write: if docId == 'state' || docId == 'main';
    }
  }
}
